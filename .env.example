# Copy into a local environment file and export the values before running an example.
EMA_UPD_CLIENT_ID=
EMA_UPD_CLIENT_SECRET=
EMA_UPD_TOKEN_ENDPOINT=
EMA_UPD_SCOPE=
EMA_UPD_PRODUCT_NAME=

# Required by smoke.php. Select the permanent identifier for the first product
# in the configured name search.
EMA_UPD_PERMANENT_IDENTIFIER=

