{
    "name": "hrabosh/ema-upd-client",
    "description": "Framework-independent PHP client for the EMA Union Product Database for veterinary medicines.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.15.2",
        "guzzlehttp/psr7": "^2.13",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5.8"
    },
    "autoload": {
        "psr-4": {
            "Hrabosh\\EmaUpd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hrabosh\\EmaUpd\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@cs:check"
        ]
    }
}
